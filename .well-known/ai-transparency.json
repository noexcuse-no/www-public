---
layout: none
permalink: /.well-known/ai-transparency.json
---
{
  "$schema": "https://ai-transparency.dev/schema/v1.json",
  "publisher": {
    "name": "No Excuse AS",
    "url": "https://noexcuse.no",
    "contact": "firmapost@noexcuse.no"
  },
  "contact": "dagfinn@noexcuse.no",
  "disclosure_statement": "Innhold på dette nettstedet er delvis generert med kunstig intelligens (KI) og gjennomgått av redaksjon. LLM-er brukes kun i støttende og pyntende rolle — spørsmål, analyser og anbefalinger er menneskelig faglabor. Vi bruker termen 'kunstig intelligens (KI)' som et felles uttrykk; det teknisk korrekte begrepet er 'store språkmodeller'.",
  "regulatory_contact": {
    "name": "Nkom",
    "url": "https://www.nkom.no/"
  },
  "declarations": {
    "text": {
      "digitalSourceType": "CompositeWithTrainedAlgorithmicMediaDigitalSource",
      "editorialReview": {
        "reviewer": "Dagfinn Bang-Johansen",
        "status": "human-reviewed"
      }
    },
    "code": {
      "digitalSourceType": "CompositeWithTrainedAlgorithmicMediaDigitalSource",
      "editorialReview": {
        "reviewer": "Dagfinn Bang-Johansen",
        "status": "human-reviewed"
      }
    },
    "styles": {
      "digitalSourceType": "CompositeWithTrainedAlgorithmicMediaDigitalSource",
      "editorialReview": {
        "reviewer": "Dagfinn Bang-Johansen",
        "status": "human-reviewed"
      }
    },
    "images": {
      "digitalSourceType": "TrainedAlgorithmicMediaDigitalSource",
      "editorialReview": {
        "reviewer": "Dagfinn Bang-Johansen",
        "status": "human-reviewed"
      },
      "count": {{ site.data.rights.assets | where_exp: "item", "item.creation == 'ai-generated'" | size }}
    }
  },
  "editorial_responsibility": "/om-store-sprakmodeller/",
  "routes": [
{% assign rights_pages = site.data.rights.pages %}
{% assign all_pages = site.pages | concat: site.tags %}
{% for page in all_pages %}
  {% if page.path and page.path contains ".md" %}
    {% assign prov = page.provenance %}
    {% assign page_rights = rights_pages[page.path] %}
    {% assign ai_content = "none" %}
    {% if prov.creation == "ai-generated" %}
      {% assign ai_content = "full" %}
    {% elsif prov.creation == "ai-assisted" %}
      {% assign ai_content = "editorial" %}
    {% elsif prov.creation == "unresolved" %}
      {% assign ai_content = "unknown" %}
    {% elsif prov.creation == "third-party" %}
      {% assign ai_content = "third-party" %}
    {% else %}
      {% assign ai_content = "minimal" %}
    {% endif %}
    {
      "path": "{{ page.url | relative_url }}",
      "ai_content": "{{ ai_content }}",
      "editorial_review": {{ prov.editorial_review | default: true }}
    }{% unless forloop.last %},{% endunless %}
  {% endif %}
{% endfor %}
  ]
}